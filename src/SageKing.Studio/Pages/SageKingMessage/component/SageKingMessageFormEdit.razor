        }
        @if (model.AttsbyteLst.HasItem())
        {
            var currLst = model.AttsbyteLst.OrderBy(a => a.Key).ToList();
            @for (int i = 0; i < currLst.Count; i++)
            {
                var item = currLst[i];
                <Space>
                    @GetSpaceItem(item)
                </Space>
            }
        }

        @if (model.AttbyteLst.HasItem())
        {
            var currLst = model.AttbyteLst.OrderBy(a => a.Key).ToList();
            @for (int i = 0; i < currLst.Count; i++)
            {
                var item = currLst[i];

