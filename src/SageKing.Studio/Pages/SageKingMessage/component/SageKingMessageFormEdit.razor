@namespace SageKing.Studio.Pages.SysSageKingMessage.component

@inject SysDictTypeService selectService

<Form @ref="form"
      Model="@model" ValidateMode="FormValidateMode.Complex"
      ValidateOnChange="true"
      LabelColSpan="6" WrapperColSpan="18">
    <Space Size=@("10") Wrap Align="center">
        @if (model.AttStrLst != null)
        {
            var currLst = model.AttStrLst.OrderBy(a => a.Key).ToList();
            @for (int i = 0; i < currLst.Count; i++)
