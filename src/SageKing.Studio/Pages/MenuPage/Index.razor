    </div>
    ;
    #endregion

    [CascadingParameter]
    public Error? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await InitTabTitle();
            await InitSelectData();
            await Refresh(false);
            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            Error?.ProcessError(ex, TabTitle);
        }
    }
    async Task InitTabTitle()
    {
        if (menuid <= 0)
        {
            return;
        }
        var getmenu = await dataService.GetMenuCacheAsync(menuid);
        if (getmenu == null)
        {
            return;
        }
        TabIcon = getmenu.Icon.NullOrWhiteSpaceToDefault("home");
        TabTitle = getmenu.Title;
    }
    async Task InitSelectData()
    {
        data = await dataService.GetToTreeCacheAsync();
        selectedRows = new List<SysMenu>();
        searchModel = new SysMenu();
    }

    #endregion

    #region tree
    private void ExpandAll()
    {
        _tree.ExpandAll();
    }

    private void ExpandAllChild()
    {
        _tree.ExpandAll();
    }

    public async Task OnNodeLoadDelayAsync(TreeEventArgs<SysMenu> args)
    {
        var dataItem = ((SysMenu)args.Node.DataItem);
        // dataItem.Children.Clear();
        //load children
    }

