    void onDrop(TreeEventArgs<SysMenu> e)
    {

    }

    void OnDragEnd(TreeEventArgs<SysMenu> e)
    {

    }
    #endregion

    async Task Refresh(bool notice = true)
    {

    }
    void ReSet()
    {
        searchModel = new SysMenu();
    }

    void Message(string msg = "查询成功")
    {
        _ = _message.Success(msg);
    } 
}
