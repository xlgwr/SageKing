@namespace SageKing.Studio.Pages.Base


<MarkdownEditor @bind-Value="@markdownValue"
                ValueHTMLChanged="@OnMarkdownValueHTMLChanged"
                SpellChecker="false" AutoDownloadFontAwesome="true" @ref="Markdown1" AutoSaveEnabled="true" CustomButtonClicked="@OnCustomButtonClicked">
</MarkdownEditor>


@code {
    [Parameter]
    public bool isShow { get; set; }

    [Parameter]
    public string markdownValue { get; set; }

    MarkdownEditor Markdown1;

    string markdownHtml;
    string buttonText; 

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {

        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            if (Markdown1 != null)
            {
                await Markdown1.SetValueAsync(markdownValue);
            }
        }

    }
    public async Task ChangeText(string Value)
    {
        markdownValue = Value;
        if (Markdown1 != null)
        {
            await Markdown1.SetValueAsync(markdownValue);
        }
    }

    Task OnMarkdownValueChanged(string value)
    {
        return Task.CompletedTask;
    }

    Task OnMarkdownValueHTMLChanged(string value)
    {
        markdownHtml = value;
        return Task.CompletedTask;
    }

    Task OnCustomButtonClicked(MarkdownButtonEventArgs eventArgs)
    {
        Console.WriteLine("OnCustomButtonClicked -> " + eventArgs.Value);
        buttonText += "OnCustomButtonClicked -> " + eventArgs.Value + "<br />";

        return Task.CompletedTask;
    }
}
