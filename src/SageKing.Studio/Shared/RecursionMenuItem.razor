@if (ChildContent != null)
{
    @if (menu.Children.Count > 0)
    {
        <SubMenu Key="@menu.Name" TitleTemplate=@GetRenderFragment(menu.Title,menu.Icon)>
            @ChildContent
        </SubMenu>
    }
    else
    {
        <MenuItem RouterLink="@menu.PathWithId" RouterMatch="NavLinkMatch.All" Key="@menu.Name" Title="@menu.Title" Icon="@menu.Icon">
        </MenuItem>
    }

}
@inject NavigationManager nav;
@inject ReuseTabsService tab;
@code {

    [Parameter]
    public SysMenu menu { get; set; }

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    RenderFragment GetRenderFragment(string title, string iceType = "setting")
    {
        return
    @<span>
        <Icon Type=@iceType Theme="outline"></Icon>
        <span>@title</span>
    </span>
    ;
    }
}